{
  "name": "scopedalerts",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "serve:ssr:scopedalerts": "node dist/scopedalerts/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-server": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@angular/ssr": "^22.2.5",
    "@anthropic-ai/sdk": "^0.132.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "firebase": "^13.2.0",
    "marked": "^18.1.2",
    "rss": "^1.2.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@types/express": "^5.0.6",
    "@types/node": "^20.17.19",
    "jsdom": "^27.0.0",
    "typescript": "~6.0.3",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
